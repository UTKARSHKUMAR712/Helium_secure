<Window x:Class="HeliumSecure.Views.RenameProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Vault" Height="270" Width="450"
        Icon="pack://application:,,,/HeliumSecure;component/Assets/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0B0E17" Foreground="#F8FAFC" FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Rename Profile Vault" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Update the display name of this encrypted profile." FontSize="12" Foreground="#818EA3" Margin="0,3,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <TextBlock Text="NEW DISPLAY NAME" FontSize="11" FontWeight="Bold" Foreground="#818EA3" Margin="2,0,0,6"/>
            <TextBox x:Name="ProfileNameBox" Height="40" Margin="0,0,0,10"/>
            <TextBlock x:Name="ErrorMessage" Text="" FontSize="12" Foreground="#FDA4AF" Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#1A2234" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="85" Height="38" Margin="0,0,10,0" Click="OnCancelClick"/>
                <Button Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}" Width="90" Height="38" Click="OnSaveClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
