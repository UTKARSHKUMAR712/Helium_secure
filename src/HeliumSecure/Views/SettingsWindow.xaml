<Window x:Class="HeliumSecure.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeliumSecure — Storage Management" Height="680" Width="960"
        Icon="pack://application:,,,/HeliumSecure;component/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="#080C16" Foreground="#F8FAFC" FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
        MinWidth="860" MinHeight="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#0E1422" BorderBrush="#1C2638" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Storage Management" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Accurate filesystem measurements, profile storage inventory, and cache purging." FontSize="12" Foreground="#818EA3" Margin="0,3,0,0"/>
                </StackPanel>

                <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" Click="OnRefreshClick" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Fill="#60A5FA" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh Storage" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Scrollable Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="24,20">
            <StackPanel>
                <!-- Section 1: Storage Overview Cards -->
                <TextBlock Text="STORAGE OVERVIEW" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,10"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Installed Application -->
                    <Border Grid.Column="0" Background="#101726" CornerRadius="12" BorderBrush="#1F293D" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="APPLICATION FOOTPRINT" FontSize="10" FontWeight="Bold" Foreground="#818EA3"/>
                            <TextBlock x:Name="InstalledAppText" Text="Calculating..." FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,6,0,12"/>

                            <Grid Margin="0,2,0,4">
                                <TextBlock Text="Bundled Browser:" FontSize="12" Foreground="#818EA3" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="BundledBrowserText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="Launcher &amp; Engine:" FontSize="12" Foreground="#818EA3" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="LauncherText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: User Profiles Data -->
                    <Border Grid.Column="2" Background="#101726" CornerRadius="12" BorderBrush="#1F293D" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="USER PROFILES DATA" FontSize="10" FontWeight="Bold" Foreground="#818EA3"/>
                            <TextBlock x:Name="TotalProfilesText" Text="Calculating..." FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,6,0,12"/>

                            <Grid Margin="0,2,0,4">
                                <TextBlock Text="Encrypted Vaults &amp; Backups:" FontSize="12" Foreground="#818EA3" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="VaultsAndBackupsText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="Crash &amp; Temp Data:" FontSize="12" Foreground="#818EA3" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="CrashAndTempText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Combined Managed Footprint -->
                    <Border Grid.Column="4" Background="#101726" CornerRadius="12" BorderBrush="#2563EB" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="COMBINED MANAGED FOOTPRINT" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                            <TextBlock x:Name="CombinedFootprintText" Text="Calculating..." FontSize="22" FontWeight="Bold" Foreground="#60A5FA" Margin="0,6,0,12"/>

                            <Grid Margin="0,2,0,4">
                                <TextBlock Text="Accounting Status:" FontSize="12" Foreground="#818EA3" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="AccountingStatusText" Text="Complete" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="Storage Engine:" FontSize="12" Foreground="#818EA3" HorizontalAlignment="Left"/>
                                <TextBlock Text="NTFS Verified" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Section 2: Profiles Inventory -->
                <TextBlock Text="PROFILES STORAGE INVENTORY" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,12"/>

                <ItemsControl x:Name="ProfilesInventoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#101726" CornerRadius="12" BorderBrush="#1F293D" BorderThickness="1" Padding="20" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Profile Name, Status Badge, and ID -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,12,0"/>
                                                <Border CornerRadius="6" Background="{Binding StatusBgBrush}" BorderBrush="{Binding StatusBorderBrush}" BorderThickness="1" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusFgBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ProfileId, StringFormat='ID: {0}'}" FontFamily="Consolas" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalSizeFormatted}" FontSize="20" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                                            <TextBlock Text="Total Profile Storage" FontSize="11" Foreground="#818EA3" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Middle Row: Sub-metrics Grid -->
                                    <Border Grid.Row="1" Background="#0C121E" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Vault File (.hsv)" FontSize="10" FontWeight="Bold" Foreground="#818EA3"/>
                                                <TextBlock Text="{Binding VaultSizeFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Backup (.bak)" FontSize="10" FontWeight="Bold" Foreground="#818EA3"/>
                                                <TextBlock Text="{Binding BackupSizeFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Working Dir" FontSize="10" FontWeight="Bold" Foreground="#818EA3"/>
                                                <TextBlock Text="{Binding WorkingDirectoryFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Crash &amp; Temp" FontSize="10" FontWeight="Bold" Foreground="#818EA3"/>
                                                <TextBlock Text="{Binding CrashRecoveryFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Row: Timestamps and Action Buttons -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CreatedAtFormatted, StringFormat='Created: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,0,16,0"/>
                                            <TextBlock Text="{Binding LastUsedFormatted, StringFormat='Last used: {0}'}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Clear Storage..." Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Margin="0,0,10,0" Tag="{Binding ProfileId}" Click="OnClearStorageItemClick"/>
                                            <Button Content="Delete Profile..." Style="{StaticResource DangerButton}" Height="34" Padding="14,0" Tag="{Binding ProfileId}" Click="OnDeleteProfileItemClick"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Footer -->
        <Border Grid.Row="2" Background="#0E1422" BorderBrush="#1C2638" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource PrimaryButton}" Width="95" Height="36" Click="OnCloseClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
