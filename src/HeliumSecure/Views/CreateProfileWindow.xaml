<Window x:Class="HeliumSecure.Views.CreateProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Private Profile" Height="360" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#18181B" Foreground="#F4F4F5" FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Create New Profile" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
            <TextBlock Text="Each profile is isolated in its own AES-256-GCM encrypted vault." FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <TextBlock Text="Profile Name" FontSize="13" FontWeight="Medium" Foreground="#E4E4E7" Margin="0,0,0,4"/>
            <TextBox x:Name="ProfileNameBox" Height="34" Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" BorderThickness="1" Padding="8,4" FontSize="14" Margin="0,0,0,12"/>

            <TextBlock Text="Password" FontSize="13" FontWeight="Medium" Foreground="#E4E4E7" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="34" Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" BorderThickness="1" Padding="8,4" FontSize="14" Margin="0,0,0,12"/>

            <TextBlock Text="Confirm Password" FontSize="13" FontWeight="Medium" Foreground="#E4E4E7" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="34" Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" BorderThickness="1" Padding="8,4" FontSize="14" Margin="0,0,0,8"/>

            <TextBlock x:Name="ErrorMessage" Text="" FontSize="12" Foreground="#EF4444" Margin="0,0,0,8" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="85" Height="34" Background="#27272A" Foreground="#E4E4E7" BorderThickness="1" BorderBrush="#3F3F46" Margin="0,0,10,0" Click="OnCancelClick" Cursor="Hand"/>
            <Button Content="Create" Width="95" Height="34" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Click="OnCreateClick" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
