<Window x:Class="HeliumSecure.Views.CreateProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Private Vault"
        Icon="pack://application:,,,/HeliumSecure;component/Assets/app.ico"
        Width="480" MinWidth="420" MaxWidth="540"
        Height="540" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E17" Foreground="#F8FAFC" FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fixed Header with Vector Icon -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,16,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/HeliumSecure;component/Assets/app.png" Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Create Private Vault" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Hardware-isolated at-rest inside an AES-256-GCM encrypted vault." FontSize="12" Foreground="#818EA3" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Vertically Scrollable Content Area with Ultra-Thin ScrollBar -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Padding="0,0,8,0">
            <StackPanel VerticalAlignment="Top">
                <!-- Zero-Knowledge Callout -->
                <Border Background="#121727" BorderBrush="#1F2840" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                  Fill="#818CF8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ZERO-KNOWLEDGE POLICY" FontSize="10" FontWeight="Bold" Foreground="#818CF8"/>
                        </StackPanel>
                        <TextBlock Text="HeliumSecure does not store plaintext passwords or recovery keys. If the password is lost, data is mathematically unrecoverable. 3 failed attempts trigger a 30-min lockout; 5 attempts in Stage 2 permanently destroy the vault." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="VAULT PROFILE NAME" FontSize="11" FontWeight="Bold" Foreground="#818EA3" Margin="2,0,0,6"/>
                <TextBox x:Name="ProfileNameBox" Height="40" Margin="0,0,0,16"/>

                <TextBlock Text="MASTER PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#818EA3" Margin="2,0,0,6"/>
                <PasswordBox x:Name="PasswordBox" Height="40" Margin="0,0,0,16"/>

                <TextBlock Text="CONFIRM MASTER PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#818EA3" Margin="2,0,0,6"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="40" Margin="0,0,0,10"/>

                <Border x:Name="ErrorContainer" Background="#3B1219" BorderBrush="#E11D48" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,4,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMessage" Text="" FontSize="12" Foreground="#FDA4AF" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Fixed Footer Outside Scrollable Content -->
        <Border Grid.Row="2" BorderBrush="#1A2234" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="90" Height="38" Margin="0,0,12,0" Click="OnCancelClick"/>
                <Button Content="Create Vault" IsDefault="True" Style="{StaticResource PrimaryButton}" Width="120" Height="38" Click="OnCreateClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
