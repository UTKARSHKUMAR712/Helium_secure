<Window x:Class="HeliumSecure.Views.CreateProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Private Profile"
        Width="460" MinWidth="400" MaxWidth="520"
        Height="470" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F19" Foreground="#F8FAFC" FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fixed Header with Vector Icon -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#17233D" BorderBrush="#2563EB" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"
                      Fill="#3B82F6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Create New Profile" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Isolated at-rest inside an AES-256-GCM encrypted vault." FontSize="12" Foreground="#818EA3" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Vertically Scrollable Content Area with Ultra-Thin ScrollBar -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Padding="0,0,8,0">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="PROFILE NAME" FontSize="11" FontWeight="Bold" Foreground="#818EA3" Margin="2,0,0,6"/>
                <TextBox x:Name="ProfileNameBox" Height="40" Margin="0,0,0,16"/>

                <TextBlock Text="MASTER PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#818EA3" Margin="2,0,0,6"/>
                <PasswordBox x:Name="PasswordBox" Height="40" Margin="0,0,0,16"/>

                <TextBlock Text="CONFIRM PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#818EA3" Margin="2,0,0,6"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="40" Margin="0,0,0,10"/>

                <Border x:Name="ErrorContainer" Background="#3B1219" BorderBrush="#E11D48" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,4,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMessage" Text="" FontSize="12" Foreground="#FDA4AF" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Fixed Footer Outside Scrollable Content -->
        <Border Grid.Row="2" BorderBrush="#1C2638" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="90" Height="38" Margin="0,0,12,0" Click="OnCancelClick"/>
                <Button Content="Create Profile" IsDefault="True" Style="{StaticResource PrimaryButton}" Width="120" Height="38" Click="OnCreateClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
