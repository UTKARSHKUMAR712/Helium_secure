<Window x:Class="HeliumSecure.Views.CreateProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Private Profile"
        Width="440" MinWidth="380" MaxWidth="520"
        Height="420" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Background="#18181B" Foreground="#F4F4F5" FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fixed Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Create New Profile" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
            <TextBlock Text="Each profile is isolated in its own AES-256-GCM encrypted vault." FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Vertically Scrollable Content Area -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Padding="0,0,6,0">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="Profile Name" FontSize="13" FontWeight="Medium" Foreground="#E4E4E7" Margin="0,0,0,4"/>
                <TextBox x:Name="ProfileNameBox" Height="34" Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" BorderThickness="1" Padding="8,4" FontSize="14" Margin="0,0,0,12"/>

                <TextBlock Text="Password" FontSize="13" FontWeight="Medium" Foreground="#E4E4E7" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Height="34" Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" BorderThickness="1" Padding="8,4" FontSize="14" Margin="0,0,0,12"/>

                <TextBlock Text="Confirm Password" FontSize="13" FontWeight="Medium" Foreground="#E4E4E7" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="34" Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" BorderThickness="1" Padding="8,4" FontSize="14" Margin="0,0,0,8"/>

                <TextBlock x:Name="ErrorMessage" Text="" FontSize="12" Foreground="#EF4444" Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Fixed Footer Outside Scrollable Content -->
        <Border Grid.Row="2" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Width="85" Height="34" Background="#27272A" Foreground="#E4E4E7" BorderThickness="1" BorderBrush="#3F3F46" Margin="0,0,10,0" Click="OnCancelClick" Cursor="Hand"/>
                <Button Content="Create" IsDefault="True" Width="95" Height="34" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Click="OnCreateClick" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
