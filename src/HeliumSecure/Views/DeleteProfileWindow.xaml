<Window x:Class="HeliumSecure.Views.DeleteProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Vault" Height="360" Width="480"
        Icon="pack://application:,,,/HeliumSecure;component/Assets/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#080C16" Foreground="#F8FAFC" FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Delete Encrypted Vault" FontSize="18" FontWeight="Bold" Foreground="#F43F5E"/>
            <TextBlock x:Name="WarningText" Text="Are you sure you want to permanently delete this profile?" FontSize="12" Foreground="#818EA3" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <!-- Irreversible Warning Callout -->
            <Border Background="#2B1218" BorderBrush="#E11D48" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="PERMANENT &amp; IRREVERSIBLE ACTION" FontSize="10" FontWeight="Bold" Foreground="#FDA4AF" Margin="0,0,0,3"/>
                    <TextBlock Text="All encrypted cookies, history, vault keys, backups, and working data will be shredded. Once deleted, this profile cannot be recovered under any circumstances." FontSize="11" Foreground="#FDA4AF" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="ENTER MASTER PASSWORD TO CONFIRM" FontSize="11" FontWeight="Bold" Foreground="#818EA3" Margin="2,0,0,6"/>
            <PasswordBox x:Name="PasswordBox" Height="40" Margin="0,0,0,8"/>
            <TextBlock x:Name="ErrorMessage" Text="" FontSize="12" Foreground="#FDA4AF" Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#1A2234" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="85" Height="38" Margin="0,0,10,0" Click="OnCancelClick"/>
                <Button Content="Permanently Delete" IsDefault="True" Style="{StaticResource DangerButton}" Width="160" Height="38" Click="OnDeleteClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
