<Window x:Class="HeliumSecure.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helium Pro" Height="620" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19" Foreground="#F8FAFC" FontFamily="Segoe UI"
        MinWidth="820" MinHeight="520">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#0E1422" BorderBrush="#1C2638" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#1D4ED8" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="He" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Helium Pro" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Hardware-Isolated Profile Vaults &amp; Disposable Sessions" FontSize="12" Foreground="#818EA3"/>
                    </StackPanel>
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="GuestButton" Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0" Margin="0,0,12,0" Click="OnGuestClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                                  Fill="#60A5FA" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Browse as Guest" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NewProfileButton" Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" Click="OnNewProfileClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                  Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="New Profile" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Profile Selector List -->
            <Border Grid.Column="0" Background="#0C121E" BorderBrush="#1C2638" BorderThickness="0,0,1,0" Padding="16,18,16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ENCRYPTED PROFILES" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="6,0,0,12"/>

                    <ListBox x:Name="ProfilesListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="OnProfileSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBorder" CornerRadius="10" Background="#111827" BorderBrush="#1F293D" BorderThickness="1" Padding="14,12">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#172236"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2D3B55"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#152442"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3B82F6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1A263D" BorderBrush="#2563EB" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                              Fill="#60A5FA" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding LastUsedText}" FontSize="11" Foreground="#818EA3" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Profile Unlock & Launch Panel -->
            <Border Grid.Column="1" Padding="36" Background="#0B0F19">
                <Grid x:Name="ProfileDetailsPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Profile Header Details -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,28">
                        <TextBlock x:Name="SelectedProfileName" Text="Select a Profile" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border x:Name="StatusBadge" CornerRadius="6" Background="#162035" BorderBrush="#233555" BorderThickness="1" HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#60A5FA" Margin="0,0,6,0"/>
                                <TextBlock x:Name="SelectedProfileStatus" Text="AES-256-GCM Vault Secured" FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Master Password Card -->
                    <Border Grid.Row="1" Background="#101726" CornerRadius="12" Padding="24" BorderBrush="#1F293D" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MASTER PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#818EA3" Margin="2,0,0,8"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="ProfilePasswordBox" Grid.Column="0" Height="42" KeyDown="OnPasswordKeyDown"/>
                                <TextBox x:Name="ProfilePasswordTextBox" Grid.Column="0" Height="42" Visibility="Collapsed" KeyDown="OnPasswordKeyDown"/>

                                <Button x:Name="TogglePasswordButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Width="44" Height="42" Margin="8,0,0,0" Click="OnTogglePasswordVisibility" ToolTip="Show/Hide Password" Padding="0">
                                    <Path x:Name="TogglePasswordIcon"
                                          Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                          Fill="#818EA3" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <Border x:Name="StatusMessageContainer" Background="#142138" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                                <TextBlock x:Name="StatusMessage" Text="" FontSize="12" Foreground="#93C5FD" TextWrapping="Wrap"/>
                            </Border>

                            <Button x:Name="UnlockButton" Style="{StaticResource PrimaryButton}" Height="44" FontSize="14" FontWeight="Bold" Click="OnUnlockAndLaunchClick">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                          Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="UnlockButtonText" Text="Unlock &amp; Launch Browser" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Management Actions Footer -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="RenameButton" Content="Rename" Style="{StaticResource SecondaryButton}" Width="90" Height="36" Margin="0,0,12,0" Click="OnRenameClick"/>
                        <Button x:Name="DeleteButton" Content="Delete Profile" Style="{StaticResource DangerButton}" Width="110" Height="36" Click="OnDeleteClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#090D16" BorderBrush="#161F2E" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                          Fill="#10B981" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BrowserPathStatus" Text="Detecting Helium Browser..." FontSize="12" Foreground="#818EA3"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AES-256-GCM + Argon2id" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
