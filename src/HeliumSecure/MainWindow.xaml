<Window x:Class="HeliumSecure.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeliumSecure — Browser Vault" Height="730" Width="1090"
        Icon="pack://application:,,,/HeliumSecure;component/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="#080B14" Foreground="#F8FAFC" FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        MinWidth="960" MinHeight="620">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="236"/>
            <!-- Main Content Workspace -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- SIDEBAR -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#060810" BorderBrush="#121A2B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Nav Tabs -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Actions & Status -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Border Grid.Row="0" Padding="18,18,18,16" BorderBrush="#121A2B" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center" Background="#0C1424" BorderBrush="#1C2E52" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="12" Opacity="0.3" ShadowDepth="1"/>
                            </Border.Effect>
                            <Image Source="pack://application:,,,/HeliumSecure;component/Assets/app.png" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HeliumSecure" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="PRIVATE BROWSER VAULT" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation Tabs -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,16,12,14">
                    <StackPanel>
                        <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="10,0,0,10"/>

                        <!-- Dashboard Tab -->
                        <RadioButton x:Name="NavDashboardButton" Style="{StaticResource NavTabButton}" GroupName="NavTabs" IsChecked="True" Checked="OnNavTabChecked">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Vaults Tab -->
                        <RadioButton x:Name="NavVaultsButton" Style="{StaticResource NavTabButton}" GroupName="NavTabs" Checked="OnNavTabChecked">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Profile Vaults" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Security Tab -->
                        <RadioButton x:Name="NavSecurityButton" Style="{StaticResource NavTabButton}" GroupName="NavTabs" Checked="OnNavTabChecked">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Security Architecture" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Storage Settings Tab -->
                        <RadioButton x:Name="NavSettingsButton" Style="{StaticResource NavTabButton}" GroupName="NavTabs" Checked="OnNavTabChecked">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Storage &amp; Settings" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Update Center Tab -->
                        <RadioButton x:Name="NavUpdateCenterButton" Style="{StaticResource NavTabButton}" GroupName="NavTabs" Checked="OnNavTabChecked">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Update Center" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer -->
                <Border Grid.Row="2" Padding="14,14" BorderBrush="#121A2B" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <!-- Disposable Guest Button -->
                        <Button x:Name="SidebarGuestButton" Style="{StaticResource SecondaryButton}" Height="38" Padding="10,0" Margin="0,0,0,10" Click="OnGuestClick">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="M7 2v11h3v9l7-12h-4l4-8z"
                                      Fill="#10B981" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Browse as Guest" FontWeight="SemiBold" FontSize="12.5" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Hardware Isolation Status Card -->
                        <Border Background="#071512" CornerRadius="8" BorderBrush="#0D382B" BorderThickness="1" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="6" Opacity="0.7" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="AES-256-GCM + Argon2id" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                    <TextBlock Text="Hardware-Isolated Active" FontSize="9.5" Foreground="#6EE7B7"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN WORKSPACE -->
        <!-- ========================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Header -->
                <RowDefinition Height="Auto"/>
                <!-- Active Content View -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="#090D18" BorderBrush="#121A2B" BorderThickness="0,0,0,1" Padding="28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText" Text="Dashboard" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="HeaderSubtitleText" Text="Hardware-isolated profile vaults and disposable guest sessions" FontSize="12" Foreground="#818EA3" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Header Right: Browser Status & New Vault Action -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Browser Path Pill -->
                        <Border Background="#081A16" CornerRadius="8" BorderBrush="#0F4739" BorderThickness="1" Padding="12,7" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="BrowserStatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="6" Opacity="0.6" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="BrowserStatusPill" Text="Helium 0.20.1.1 Linked" FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Primary Action: New Vault -->
                        <Button x:Name="HeaderNewVaultButton" Style="{StaticResource PrimaryButton}" Height="38" Padding="18,0" Click="OnNewProfileClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                      Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="New Vault" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- VIEW 1: DASHBOARD PAGE -->
            <!-- ========================================== -->
            <ScrollViewer x:Name="DashboardPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24" Visibility="Visible">
                <StackPanel>
                    <!-- Top Stat Cards (4 Cards) -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Vault Count -->
                        <Border Grid.Column="0" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="ENCRYPTED VAULTS" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Border Width="26" Height="26" CornerRadius="6" Background="#0E1E38" BorderBrush="#1C345E" BorderThickness="1" HorizontalAlignment="Right">
                                        <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"
                                              Fill="#3B82F6" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="DashVaultCountText" Text="0 Profiles" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,4"/>
                                <TextBlock Text="AES-256-GCM at rest" FontSize="11" Foreground="#8A9CB4"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Security Engine -->
                        <Border Grid.Column="2" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="KEY DERIVATION" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Border Width="26" Height="26" CornerRadius="6" Background="#1B1638" BorderBrush="#322860" BorderThickness="1" HorizontalAlignment="Right">
                                        <Path Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                                              Fill="#818CF8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Argon2id" FontSize="22" FontWeight="Bold" Foreground="#818CF8" Margin="0,2,0,4"/>
                                <TextBlock Text="64 MB / 3 passes / 4 lanes" FontSize="11" Foreground="#8A9CB4"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Session State -->
                        <Border Grid.Column="4" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="ACTIVE SESSION" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Border Width="26" Height="26" CornerRadius="6" Background="#0B251D" BorderBrush="#144A3A" BorderThickness="1" HorizontalAlignment="Right">
                                        <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                              Fill="#10B981" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="DashActiveSessionText" Text="All Locked" FontSize="22" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,4"/>
                                <TextBlock Text="Job Object confinement" FontSize="11" Foreground="#8A9CB4"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Guest Mode -->
                        <Border Grid.Column="6" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="DISPOSABLE GUEST" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Border Width="26" Height="26" CornerRadius="6" Background="#0C2538" BorderBrush="#164362" BorderThickness="1" HorizontalAlignment="Right">
                                        <Path Data="M7 2v11h3v9l7-12h-4l4-8z"
                                              Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Ready" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,4"/>
                                <TextBlock Text="Zero disk residue on exit" FontSize="11" Foreground="#8A9CB4"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Middle Grid: Recently Used Vaults + Quick Actions -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Recently Used Vaults -->
                        <Border Grid.Column="0" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="22">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <TextBlock Text="RECENT PRIVATE VAULTS" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Button Content="View All →" Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" FontSize="11" HorizontalAlignment="Right" Click="OnViewAllVaultsClick"/>
                                </Grid>

                                <!-- Recent Profiles List -->
                                <ItemsControl x:Name="DashRecentVaultsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="RecentProfileCard" Background="#0C1220" CornerRadius="10" BorderBrush="#1B2640" BorderThickness="1" Padding="14,12" Margin="0,0,0,10"
                                                    Cursor="Hand" MouseLeftButtonUp="OnRecentProfileCardClick">
                                                <StackPanel>
                                                    <!-- Main Card Header Row -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Avatar Circle -->
                                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#16233D" BorderBrush="#2A3D66" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="13" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Profile Name & Last Used -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                                                <Border CornerRadius="4" Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusBadgeFg}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding LastUsedText}" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                                                        </StackPanel>

                                                        <!-- Collapsed Action Button -->
                                                        <Button Grid.Column="2" Content="Unlock ▾" Style="{StaticResource PrimaryButton}" Height="30" Padding="14,0" FontSize="11" 
                                                                Tag="{Binding Id}" Click="OnRecentProfileCardToggleClick" VerticalAlignment="Center"
                                                                Visibility="{Binding CollapsedVisibility}"/>

                                                        <!-- Expanded Close Button -->
                                                        <Button Grid.Column="2" Content="✕" Style="{StaticResource SecondaryButton}" Width="30" Height="30" Padding="0" FontSize="12" 
                                                                Tag="{Binding Id}" Click="OnRecentProfileCardToggleClick" VerticalAlignment="Center"
                                                                Visibility="{Binding ExpandedVisibility}"/>
                                                    </Grid>

                                                    <!-- Inline Password Entry Panel (Shown when user clicks profile) -->
                                                    <StackPanel Visibility="{Binding ExpandedVisibility}" Margin="0,12,0,2">
                                                        <Border Height="1" Background="#162035" Margin="0,0,0,12"/>

                                                        <TextBlock Text="ENTER MASTER PASSWORD TO OPEN BROWSER" FontSize="10" FontWeight="Bold" Foreground="#8A9BB4" Margin="2,0,0,6"/>

                                                        <!-- PasswordBox with Enter key execution -->
                                                        <Grid Margin="0,0,0,8">
                                                            <PasswordBox x:Name="QuickPasswordBox" Height="40" KeyDown="OnQuickPasswordKeyDown"/>
                                                        </Grid>

                                                        <!-- Error message display if invalid password -->
                                                        <Border Background="#2B1017" BorderBrush="#E11D48" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                                                Visibility="{Binding QuickErrorVisibility}">
                                                            <TextBlock Text="{Binding QuickErrorMessage}" FontSize="11" Foreground="#FDA4AF" TextWrapping="Wrap"/>
                                                        </Border>

                                                        <!-- Actions Row -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" FontSize="11" Margin="0,0,8,0"
                                                                    Click="OnQuickUnlockCancelClick"/>
                                                            <Button Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" FontSize="11"
                                                                    Click="OnQuickUnlockSubmitClick">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                                                          Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Unlock &amp; Open Browser" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State when 0 profiles -->
                                <Border x:Name="DashEmptyVaultsPrompt" Background="#0A0E1A" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="36,32" Visibility="Collapsed" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Ambient Glowing Shield Badge -->
                                        <Border Width="60" Height="60" CornerRadius="18" Background="#111B30" BorderBrush="#223660" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#3B82F6" BlurRadius="22" Opacity="0.3" ShadowDepth="1"/>
                                            </Border.Effect>
                                            <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                                  Fill="#60A5FA" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="No Private Vaults Created" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Create your first hardware-isolated vault to begin private, encrypted browsing. All sessions, cookies, and history stay sealed with AES-256-GCM." FontSize="12.5" Foreground="#8A9CB4" HorizontalAlignment="Center" Margin="0,6,0,18" TextAlignment="Center" MaxWidth="380" LineHeight="19"/>
                                        <Button Content="+ Create First Vault" Style="{StaticResource PrimaryButton}" Height="38" Padding="20,0" FontSize="12.5" Click="OnNewProfileClick" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right Column: Disposable Guest & Security Architecture Highlight -->
                        <StackPanel Grid.Column="2">
                            <!-- Disposable Guest Card -->
                            <Border Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="24" Height="24" CornerRadius="6" Background="#0B251D" BorderBrush="#144A3A" BorderThickness="1" Margin="0,0,8,0">
                                                <Path Data="M7 2v11h3v9l7-12h-4l4-8z"
                                                      Fill="#10B981" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="DISPOSABLE GUEST" FontSize="11" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Browse without traces. An isolated sandbox memory space is generated for this session. When closed, all history, cookies, and disk files are shredded." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>
                                    <Button Content="Launch Guest Window" Style="{StaticResource SecondaryButton}" Height="34" Click="OnGuestClick"/>
                                </StackPanel>
                            </Border>

                            <!-- Two-Stage Security Architecture Card -->
                            <Border Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="TWO-STAGE SECURITY GUARANTEE" FontSize="11" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,14"/>
                                    
                                    <!-- Policy Row 1 -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Background="#0E1E38" BorderBrush="#1D3B73" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="3 failed attempts → 30-min lockout" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                            <TextBlock Text="Defeats automated dictionary attacks." FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Policy Row 2 -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Background="#26170A" BorderBrush="#543011" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="5 Stage-2 failures → Destruction" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                            <TextBlock Text="Irrecoverably shreds the encrypted vault." FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Policy Row 3 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Background="#0B251D" BorderBrush="#144A3A" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock Text="0" FontSize="11" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Zero backdoors or plaintext keys" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                            <TextBlock Text="Keys derived in RAM only and wiped on exit." FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ========================================== -->
            <!-- VIEW 2: VAULTS PAGE (PROFILES & UNLOCK) -->
            <!-- ========================================== -->
            <Grid x:Name="VaultsPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <!-- Left: Profiles List Column -->
                    <ColumnDefinition Width="340"/>
                    <!-- Right: Unlock & Vault Details Column -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Profiles List -->
                <Border Grid.Column="0" Background="#0A0E1A" BorderBrush="#141C30" BorderThickness="0,0,1,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Search & Action Bar -->
                            <RowDefinition Height="Auto"/>
                            <!-- Profiles List / Empty State -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Row="0" Margin="0,0,0,14">
                            <Grid>
                                <TextBox x:Name="VaultSearchBox" Height="38" Padding="34,8,10,8" TextChanged="OnVaultSearchTextChanged"/>
                                <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Fill="#64748B" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Profiles List -->
                        <ListBox x:Name="ProfilesListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="OnProfileSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#F8FAFC"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="CardBorder" CornerRadius="10" Background="#0E1424" BorderBrush="#1B2640" BorderThickness="1" Padding="14,12">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBorder" Property="Background" Value="#141E34"/>
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2C3E68"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="CardBorder" Property="Background" Value="#172440"/>
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3B82F6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Avatar Circle -->
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#19253F" BorderBrush="#2F426C" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="13" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Name & Last Used -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                                <Border CornerRadius="4" Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding StatusBadgeFg}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastUsedText}" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State in Left Pane -->
                        <Border x:Name="VaultsEmptyState" Grid.Row="1" Background="#0E1424" CornerRadius="10" BorderBrush="#1A253E" BorderThickness="1" Padding="20" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No Matching Vaults" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Click '+ New Vault' to create an encrypted profile." FontSize="11" Foreground="#818EA3" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                                <Button Content="+ Create Vault" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" FontSize="11" Click="OnNewProfileClick" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right: Unlock Panel & Management Actions -->
                <Border Grid.Column="1" Padding="40,32" Background="#080C16">
                    <Grid>
                        <Grid x:Name="ProfileDetailsPanel" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Profile Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Profile Avatar -->
                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" Background="#16233C" BorderBrush="#3B82F6" BorderThickness="1.5" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SelectedProfileInitials" Text="VA" FontWeight="Bold" FontSize="19" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedProfileName" Text="Select a Profile" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,12,0"/>
                                        <Border x:Name="StatusBadge" CornerRadius="6" Background="#0E1D36" BorderBrush="#1E3868" BorderThickness="1" Padding="10,3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#60A5FA" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="SelectedProfileStatus" Text="AES-256-GCM Vault Secured" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="SelectedProfileIdSnippet" Text="ID: --" FontFamily="Consolas" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Master Password Card -->
                            <Border Grid.Row="1" Background="{StaticResource CardGradient}" CornerRadius="12" Padding="26" BorderBrush="#1C2740" BorderThickness="1">
                                <StackPanel>
                                    <!-- Stage 1 Failed Attempts Notice -->
                                    <Border x:Name="Stage1AttemptsBanner" Background="#101D38" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                                  Fill="#60A5FA" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Stage1AttemptsText" Text="2 attempts remaining before a 30-minute lockout." FontSize="12" Foreground="#93C5FD" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lockout Countdown Banner -->
                                    <Border x:Name="LockoutBanner" Background="#2B1017" BorderBrush="#E11D48" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16" Visibility="Collapsed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                                      Fill="#FB7185" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="PROFILE TEMPORARILY LOCKED OUT" FontSize="11" FontWeight="Bold" Foreground="#FDA4AF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="LockoutCountdownText" Text="30m 00s remaining" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,4"/>
                                            <TextBlock Text="3 failed attempts reached. Passwords cannot be recovered or reset. Authentication is suspended until the timer elapses." FontSize="11" Foreground="#F43F5E" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Stage 2 Critical Warning Banner -->
                                    <Border x:Name="Stage2Banner" Background="#2B1705" BorderBrush="#D97706" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16" Visibility="Collapsed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                <Path Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                                                      Fill="#F59E0B" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="STAGE 2 — CRITICAL SECURITY ENFORCEMENT" FontSize="11" FontWeight="Bold" Foreground="#FDE68A"/>
                                            </StackPanel>
                                            <TextBlock x:Name="Stage2AttemptsText" Text="5 attempt(s) remaining before PERMANENT DELETION" FontSize="14" FontWeight="Bold" Foreground="#FBBF24" Margin="0,2,0,4"/>
                                            <TextBlock Text="WARNING: If these 5 attempts fail, this profile, its encrypted vault, backups, and local session files will be permanently destroyed with no possibility of recovery." FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="MASTER PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,8"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <PasswordBox x:Name="ProfilePasswordBox" Grid.Column="0" Height="44" KeyDown="OnPasswordKeyDown"/>
                                        <TextBox x:Name="ProfilePasswordTextBox" Grid.Column="0" Height="44" Visibility="Collapsed" KeyDown="OnPasswordKeyDown"/>

                                        <Button x:Name="TogglePasswordButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Width="44" Height="44" Margin="8,0,0,0" Click="OnTogglePasswordVisibility" ToolTip="Show/Hide Password" Padding="0">
                                            <Path x:Name="TogglePasswordIcon"
                                                  Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                                  Fill="#818EA3" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>

                                    <Border x:Name="StatusMessageContainer" Background="#0F1F38" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                                        <TextBlock x:Name="StatusMessage" Text="" FontSize="12" Foreground="#93C5FD" TextWrapping="Wrap"/>
                                    </Border>

                                    <Button x:Name="UnlockButton" Style="{StaticResource PrimaryButton}" Height="46" FontSize="14" FontWeight="Bold" Click="OnUnlockAndLaunchClick">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                                  Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="UnlockButtonText" Text="Unlock &amp; Launch Browser" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Contextual Actions Footer -->
                            <Border Grid.Row="3" BorderBrush="#141C30" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="ClearStorageButton" Content="Prune Storage" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Margin="0,0,10,0" Click="OnClearStorageClick"/>
                                        <Button x:Name="ChangePasswordButton" Content="Change Password" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Margin="0,0,10,0" Click="OnChangePasswordClick"/>
                                        <Button x:Name="RenameButton" Content="Rename" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Click="OnRenameClick"/>
                                    </StackPanel>

                                    <Button x:Name="DeleteButton" Grid.Column="1" Content="Delete Vault" Style="{StaticResource DangerButton}" Height="34" Padding="14,0" Click="OnDeleteClick"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Empty Right Panel Prompt -->
                        <Border x:Name="NoSelectionPrompt" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="#1C2740" BorderThickness="1" Padding="36" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Select a Profile Vault" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Choose a private vault on the left to enter its master password." FontSize="12" Foreground="#818EA3" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- VIEW 3: SECURITY ARCHITECTURE PAGE -->
            <!-- ========================================== -->
            <ScrollViewer x:Name="SecurityPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="VERIFIED CRYPTOGRAPHIC &amp; ACCESS CONTROL ARCHITECTURE" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="2,0,0,16"/>

                    <!-- Grid of Security Specification Cards -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Zero-Knowledge -->
                        <Border Grid.Column="0" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="22">
                            <StackPanel>
                                <TextBlock Text="1. ZERO-KNOWLEDGE ENFORCEMENT" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,8"/>
                                <TextBlock Text="• Plaintext passwords are never written to disk or logged.&#x0a;• Master keys are derived solely in volatile memory and zeroed immediately after cryptographic operations.&#x0a;• No recovery key, security questions, or universal backdoor exist. If the master password is lost, data is mathematically unrecoverable." FontSize="12" Foreground="#94A3B8" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Key Derivation (Argon2id) -->
                        <Border Grid.Column="2" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="22">
                            <StackPanel>
                                <TextBlock Text="2. ARGON2ID KEY DERIVATION" FontSize="11" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,8"/>
                                <TextBlock Text="• Algorithm: Argon2id via Konscious.Security.Cryptography.&#x0a;• Memory Cost: 64 MB (65,536 KB) per derivation.&#x0a;• Iterations: 3 passes; Parallelism: 4 threads.&#x0a;• Salt: 32 bytes cryptographically secure random per vault." FontSize="12" Foreground="#94A3B8" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 3: AES-256-GCM -->
                        <Border Grid.Column="0" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="22">
                            <StackPanel>
                                <TextBlock Text="3. AES-256-GCM AUTHENTICATED ENCRYPTION" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                                <TextBlock Text="• Symmetric Key: 256-bit AES authenticated cipher.&#x0a;• Nonce: 96-bit cryptographically unique per write commit.&#x0a;• Tag: 128-bit authentication tag validating ciphertext integrity.&#x0a;• AAD: Profile GUID bound as Associated Authenticated Data." FontSize="12" Foreground="#94A3B8" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Two-Stage Policy -->
                        <Border Grid.Column="2" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="22">
                            <StackPanel>
                                <TextBlock Text="4. TWO-STAGE LOCKOUT &amp; DESTRUCTION" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                                <TextBlock Text="• Stage 1: 3 failed attempts lock profile for exactly 30 minutes.&#x0a;• Clock-rollback detection prevents bypassing lockout by changing system time.&#x0a;• Stage 2: 5 additional attempts allowed upon lockout expiration.&#x0a;• Terminal Failure: 5th failure irrecoverably shreds all vault and backup data." FontSize="12" Foreground="#94A3B8" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Card 5: Isolation & Process Tracking -->
                    <Border Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="22">
                        <StackPanel>
                            <TextBlock Text="5. PROCESS ISOLATION &amp; HARDWARE CONFINEMENT" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,8"/>
                            <TextBlock Text="• Windows Job Objects confine Helium child processes and track exit lifecycle automatically.&#x0a;• Working directory is shredded and re-encrypted atomically on browser termination.&#x0a;• NTFS Security DACLs restrict profile vaults and working data directories exclusively to the current Windows user SID. Other non-admin user accounts cannot read the vault files." FontSize="12" Foreground="#94A3B8" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========================================== -->
            <!-- VIEW 4: STORAGE & SETTINGS PAGE -->
            <!-- ========================================== -->
            <ScrollViewer x:Name="SettingsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24" Visibility="Collapsed">
                <StackPanel>
                    <!-- Header with Refresh Button -->
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="FILESYSTEM STORAGE MANAGEMENT &amp; ACCOUNTING" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                        <Button x:Name="SettingsRefreshBtn" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" HorizontalAlignment="Right" Click="OnSettingsRefreshClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                      Fill="#60A5FA" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh Storage" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Storage Overview 3-Card Grid -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: App Footprint -->
                        <Border Grid.Column="0" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="APPLICATION FOOTPRINT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="SettingsInstalledAppText" Text="Calculating..." FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,6,0,10"/>
                                <Grid Margin="0,2,0,2">
                                    <TextBlock Text="Bundled Browser:" FontSize="11" Foreground="#818EA3" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="SettingsBundledBrowserText" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Launcher &amp; Engine:" FontSize="11" Foreground="#818EA3" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="SettingsLauncherText" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: User Profiles Data -->
                        <Border Grid.Column="2" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="USER PROFILES DATA" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="SettingsTotalProfilesText" Text="Calculating..." FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,6,0,10"/>
                                <Grid Margin="0,2,0,2">
                                    <TextBlock Text="Vaults &amp; Backups:" FontSize="11" Foreground="#818EA3" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="SettingsVaultsBackupsText" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Crash &amp; Temp Data:" FontSize="11" Foreground="#818EA3" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="SettingsCrashTempText" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Combined Footprint -->
                        <Border Grid.Column="4" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="MANAGED DISK FOOTPRINT" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                                <TextBlock x:Name="SettingsCombinedFootprintText" Text="Calculating..." FontSize="20" FontWeight="Bold" Foreground="#60A5FA" Margin="0,6,0,10"/>
                                <Grid Margin="0,2,0,2">
                                    <TextBlock Text="Accounting Status:" FontSize="11" Foreground="#818EA3" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="SettingsAccountingStatusText" Text="Complete" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Storage Engine:" FontSize="11" Foreground="#818EA3" HorizontalAlignment="Left"/>
                                    <TextBlock Text="NTFS Verified" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Section 2: Profiles Inventory List -->
                    <TextBlock Text="PROFILES STORAGE INVENTORY" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,12"/>

                    <ItemsControl x:Name="SettingsProfilesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: Name, Status, Total Size -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                                    <Border CornerRadius="4" Background="{Binding StatusBgBrush}" BorderBrush="{Binding StatusBorderBrush}" BorderThickness="1" Padding="8,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusFgBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ProfileId, StringFormat='ID: {0}'}" FontFamily="Consolas" FontSize="10" Foreground="#64748B" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalSizeFormatted}" FontSize="18" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                                                <TextBlock Text="Total Storage" FontSize="10" Foreground="#818EA3" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Middle Row: Sub-metrics Grid -->
                                        <Border Grid.Row="1" Background="#080D18" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="#141C30" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="VAULT" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding VaultSizeFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="BACKUP" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding BackupSizeFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="WORKING DIR" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding WorkingDirectoryFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="CRASH/TEMP" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding CrashRecoveryFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Bottom Row: Prune Storage Action -->
                                        <Grid Grid.Row="2">
                                            <TextBlock Text="{Binding LastUsedFormatted, StringFormat='Last used: {0}'}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <Button Content="Prune Storage Categories..." Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" FontSize="11" HorizontalAlignment="Right" Tag="{Binding ProfileId}" Click="OnSettingsClearStorageClick"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ========================================== -->
            <!-- VIEW 5: UPDATE CENTER PAGE                 -->
            <!-- ========================================== -->
            <ScrollViewer x:Name="UpdateCenterPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24" Visibility="Collapsed">
                <StackPanel>
                    <!-- Page header -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="UPDATE CENTER" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                            <TextBlock Text="Keep HeliumSecure launcher and the browser up to date." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- ── Section 1: Launcher ── -->
                    <Border Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="22" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="HELIUMSECURE LAUNCHER" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="INSTALLED VERSION" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock x:Name="LauncherInstalledVersionText" Text="1.0.1" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="RELEASE CHANNEL" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="Stable" FontSize="18" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="LauncherUpdateStatus" Text="Press 'Check for Updates' to query the latest release." Foreground="#64748B" FontSize="12" Margin="0,4,0,4"/>
                            <TextBlock x:Name="LauncherAvailableVersion" Foreground="#60A5FA" FontSize="12" Margin="0,2,0,2" Visibility="Collapsed"/>
                            <TextBlock x:Name="LauncherReleaseNotes" TextWrapping="Wrap" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,6" Visibility="Collapsed"/>

                            <ProgressBar x:Name="LauncherDownloadProgress" Minimum="0" Maximum="100" Height="6" Margin="0,8,0,8"
                                         Foreground="#3B82F6" Background="#141C30" Visibility="Collapsed"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="CheckLauncherUpdateButton" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0"
                                        Click="OnCheckLauncherUpdateClick" Margin="0,0,10,0">
                                    <TextBlock Text="Check for Updates" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="DownloadInstallButton" Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0"
                                        Click="OnDownloadAndInstallClick" IsEnabled="False">
                                    <TextBlock Text="Download &amp; Install" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Section 2: Browser ── -->
                    <Border Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="22" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="HELIUM BROWSER" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="INSTALLED VERSION" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock x:Name="BrowserInstalledVersion" Text="Detecting..." FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="SOURCE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="github.com/imputnet/helium-windows" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="BrowserUpdateStatus" Text="Press 'Check for Browser Updates' to check." Foreground="#64748B" FontSize="12" Margin="0,4,0,4"/>
                            <TextBlock x:Name="BrowserAvailableVersion" Foreground="#60A5FA" FontSize="12" Margin="0,2,0,2" Visibility="Collapsed"/>

                            <Border Background="#090E1A" CornerRadius="6" BorderBrush="#16233C" BorderThickness="1" Padding="12,8" Margin="0,8,0,8">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#64748B">
                                    <Run FontWeight="SemiBold" Foreground="#94A3B8">Note:</Run>
                                    <Run>Browser updates redirect to the official upstream GitHub releases page to preserve code signing authenticity.</Run>
                                </TextBlock>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="CheckBrowserUpdateButton" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0"
                                        Click="OnCheckBrowserUpdateClick" Margin="0,0,10,0">
                                    <TextBlock Text="Check for Browser Updates" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="OpenBrowserDownloadButton" Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0"
                                        Click="OnOpenBrowserDownloadPageClick" IsEnabled="False">
                                    <TextBlock Text="Open Download Page" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Section 3: Info card ── -->
                    <Border Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="22" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="ZERO-IMPACT UPDATES" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#94A3B8" LineHeight="20">
                                All updates are applied outside the running session — your encrypted vaults are never touched during the update process. AES-256-GCM vault integrity is preserved across launcher updates. Browser profile data is independently stored and is unaffected by browser binary upgrades.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
